# ============================================================
# CUSTOMER SHOPPING BEHAVIOR ANALYSIS
# Data Cleaning, Exploration, Feature Engineering & PostgreSQL
# ============================================================


# 1. IMPORT LIBRARIES

import pandas as pd

from sqlalchemy import create_engine, URL
from getpass import getpass


# 2. LOAD DATASET

df = pd.read_csv("customer_shopping_behavior.csv")

print("Dataset loaded successfully!")

# Display first five rows
display(df.head())


# 3. DATA EXPLORATION

# Dataset information
print("Dataset Information:")
df.info()

# Dataset dimensions
print("\nDataset Shape:")
print(df.shape)

# Statistical summary
print("\nStatistical Summary:")
display(df.describe(include="all"))

# Check missing values
print("\nMissing Values:")
print(df.isnull().sum())

# Check duplicate records
print("\nDuplicate Records:")
print(df.duplicated().sum())


# 4. HANDLE MISSING VALUES

# Check missing Review Rating values
print("Missing Review Ratings Before Cleaning:")
print(df["Review Rating"].isnull().sum())

# Fill missing ratings using the median rating within each category
df["Review Rating"] = df["Review Rating"].fillna(
    df.groupby("Category")["Review Rating"].transform("median")
)

# Fallback: fill any remaining missing ratings with the overall median
df["Review Rating"] = df["Review Rating"].fillna(
    df["Review Rating"].median()
)

print("\nMissing Review Ratings After Cleaning:")
print(df["Review Rating"].isnull().sum())


# 5. STANDARDIZE COLUMN NAMES

# Convert column names to lowercase and replace spaces with underscores
df.columns = (
    df.columns
    .str.lower()
    .str.replace(" ", "_", regex=False)
)

# Rename purchase amount column
df.rename(
    columns={"purchase_amount_(usd)": "purchase_amount"},
    inplace=True
)

print("Updated Column Names:")
print(df.columns.tolist())


# 6. FEATURE ENGINEERING

# Create age groups using quartiles
df["age_group"] = pd.qcut(
    df["age"],
    q=4,
    labels=["Young_Adult", "Adult", "Middle_aged", "Senior"]
)

# Convert purchase frequency into approximate days
frequency_mapping = {
    "Weekly": 7,
    "Fortnightly": 14,
    "Bi-Weekly": 14,
    "Monthly": 30,
    "Quarterly": 90,
    "Every 3 Months": 90,
    "Annually": 365
}

df["purchase_frequency_days"] = (
    df["frequency_of_purchases"].map(frequency_mapping)
)

# Check for any purchase frequency values that were not mapped
print("Unmapped Purchase Frequencies:")
print(
    df.loc[
        df["purchase_frequency_days"].isnull(),
        "frequency_of_purchases"
    ].unique()
)


# 7. REMOVE UNNECESSARY COLUMN

# Promo Code Used is excluded from the final analysis
df.drop(columns=["promo_code_used"], inplace=True)


# 8. FINAL DATA CHECK

print("Final Dataset Preview:")
display(df.head())

print("\nFinal Dataset Information:")
df.info()

print("\nFinal Dataset Shape:")
print(df.shape)

print("\nMissing Values After Cleaning:")
print(df.isnull().sum())


# 9. CONNECT TO POSTGRESQL

# Enter your database details when running this cell.
# The password is entered privately and is not hardcoded.

username = input("Enter PostgreSQL username: ")
password = getpass("Enter PostgreSQL password: ")
host = input("Enter PostgreSQL host (press Enter for localhost): ").strip()
port = input("Enter PostgreSQL port (press Enter for 5432): ").strip()
database = input("Enter PostgreSQL database name: ")

# Use default local PostgreSQL settings when fields are left blank
if not host:
    host = "localhost"

if not port:
    port = "5432"

# Securely construct the PostgreSQL connection URL
connection_url = URL.create(
    drivername="postgresql+psycopg2",
    username=username,
    password=password,
    host=host,
    port=int(port),
    database=database
)

# Create SQLAlchemy engine
engine = create_engine(connection_url)


# 10. LOAD CLEANED DATA INTO POSTGRESQL

df.to_sql(
    name="customer",
    con=engine,
    if_exists="replace",
    index=False
)

print("Data successfully loaded into PostgreSQL!")
print("Table name: customer")
print("Database:", database)


# 11. VERIFY DATABASE UPLOAD

verification_df = pd.read_sql(
    "SELECT * FROM customer LIMIT 5",
    con=engine
)

print("\nPostgreSQL Table Preview:")
display(verification_df)


# 12. CLOSE DATABASE CONNECTION

engine.dispose()

print("\nProject data processing completed successfully!")